[Unit]
Description=GPU IaaS PCIe device manager
After=local-fs.target
Before=libvirt-guests.service

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=gpu-iaas
StateDirectory=gpu-iaas-devices
ExecStartPre=/sbin/modprobe vfio-pci
ExecStart=/opt/gpu-iaas/build/pcie-device-daemon /run/gpu-iaas/device.sock /var/lib/gpu-iaas-devices /etc/gpu-iaas/devices.allowlist /sys --execute
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
